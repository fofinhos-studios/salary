{
  "name": "tiny-salary-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild frontend/app.ts --bundle --format=esm --platform=browser --target=es2022 --minify --outfile=static/app.mjs && node -e \"const fs=require('node:fs');fs.mkdirSync('static/icons',{recursive:true});for(const name of ['style.css','Phosphor.woff2'])fs.copyFileSync('node_modules/@phosphor-icons/web/src/regular/'+name,'static/icons/'+name);fs.copyFileSync('node_modules/@phosphor-icons/web/LICENSE','static/icons/LICENSE')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run check:generated && npm run coverage",
    "check:generated": "node scripts/check_generated.mjs"
  },
  "dependencies": {
    "@phosphor-icons/web": "2.1.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  }
}

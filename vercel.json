{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "static",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{.cache/**,.venv/**,tests/**,static/**}"
    }
  },
  "rewrites": [
    { "source": "/api/currencies", "destination": "/api/index?resource=currencies" },
    { "source": "/api/rate", "destination": "/api/index?resource=rate" },
    { "source": "/api/br/rate", "destination": "/api/index?resource=br_rate" },
    { "source": "/api/br/tax-rules", "destination": "/api/index?resource=tax_rules" },
    { "source": "/static/:path*", "destination": "/:path*" }
  ],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self'; font-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" }
    ]
  }]
}
